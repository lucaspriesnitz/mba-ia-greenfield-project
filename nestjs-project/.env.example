# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object storage (MinIO for local development)
STORAGE_INTERNAL_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube
STORAGE_BUCKET=streamtube
STORAGE_PRESIGN_TTL_SECONDS=900

# Processing queue (Redis / BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379
VIDEO_QUEUE_ATTEMPTS=3
VIDEO_QUEUE_BACKOFF_MS=5000
# Redis key namespace for the queue. The test suite overrides it with a
# namespace of its own (see src/test/queue-prefix.ts), which is what lets the
# video-worker stay up while `npm test` runs without eating the jobs the tests
# enqueue. Leave it alone unless two stacks must share one Redis.
VIDEO_QUEUE_PREFIX=streamtube

# Video upload and processing
VIDEO_MAX_UPLOAD_BYTES=10737418240
VIDEO_UPLOAD_PART_SIZE_BYTES=67108864
VIDEO_THUMBNAIL_OFFSET_SECONDS=3
VIDEO_ACCEPTED_MIME_TYPES="video/mp4,video/quicktime,video/x-matroska,video/webm"
